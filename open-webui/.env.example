# Open WebUI 配置文件
# 此文件包含 Open WebUI 的运行时配置选项
# 修改后需要重启服务才能生效

# ================================
# 服务器配置
# ================================

# 服务监听端口 (默认: 8080)
OPENWEBUI_PORT=8080

# 服务监听地址 (默认: 0.0.0.0 表示所有接口)
# 设置为 127.0.0.1 仅允许本地访问
OPENWEBUI_HOST=0.0.0.0

# 工作进程数 (默认: 1)
# 多进程可以提高并发性能，但会增加内存使用
WORKERS=1

# ================================
# 日志配置
# ================================

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/openwebui.log

# 日志文件最大大小 (MB)
LOG_MAX_SIZE=50

# 保留的日志文件数量
LOG_BACKUP_COUNT=5

# ================================
# 功能配置
# ================================

# 是否自动打开浏览器 (true/false)
AUTO_OPEN_BROWSER=true

# 是否启用用户注册 (true/false)
ENABLE_SIGNUP=true

# 是否启用网络搜索功能 (true/false)
ENABLE_WEB_SEARCH=true

# 是否启用图像生成功能 (true/false)
ENABLE_IMAGE_GENERATION=true

# ================================
# 安全配置
# ================================

# WebUI 密钥 (自动生成，请勿手动修改)
# WEBUI_SECRET_KEY=auto-generated

# JWT 令牌过期时间 (秒)
JWT_EXPIRES_IN=86400

# 最大文件上传大小 (MB)
MAX_FILE_SIZE=100

# ================================
# 数据库配置
# ================================

# 数据库 URL (默认使用 SQLite)
# DATABASE_URL=sqlite:///data/webui.db

# 对于 PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/openwebui

# 对于 MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/openwebui

# ================================
# AI 提供商配置
# ================================

# OpenAI API 配置
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Anthropic API 配置
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434

# Google AI 配置
# GOOGLE_API_KEY=your-google-api-key

# ================================
# RAG (检索增强生成) 配置
# ================================

# 向量数据库类型 (chroma, qdrant, weaviate)
VECTOR_DB=chroma

# Chroma 数据库路径
CHROMA_DB_PATH=data/chroma

# 文档分块大小
CHUNK_SIZE=1000

# 文档分块重叠
CHUNK_OVERLAP=200

# ================================
# 缓存配置
# ================================

# 是否启用缓存 (true/false)
ENABLE_CACHE=true

# 缓存类型 (memory, redis)
CACHE_TYPE=memory

# Redis 配置 (当 CACHE_TYPE=redis 时)
# REDIS_URL=redis://localhost:6379/0

# ================================
# 代理配置
# ================================

# HTTP 代理
# HTTP_PROXY=http://proxy.example.com:8080

# HTTPS 代理
# HTTPS_PROXY=https://proxy.example.com:8080

# 不使用代理的地址
# NO_PROXY=localhost,127.0.0.1,.local

# ================================
# 开发配置
# ================================

# 开发模式 (true/false)
# 启用后会显示更详细的错误信息和调试功能
DEV_MODE=false

# 热重载 (true/false)
# 开发模式下自动重载代码变更
HOT_RELOAD=false

# ================================
# 性能配置
# ================================

# 请求超时时间 (秒)
REQUEST_TIMEOUT=300

# 连接池大小
CONNECTION_POOL_SIZE=20

# 最大并发连接数
MAX_CONNECTIONS=100

# ================================
# 自定义配置
# ================================

# 自定义主题
# CUSTOM_THEME=dark

# 自定义 CSS 文件路径
# CUSTOM_CSS=static/custom.css

# 自定义 JavaScript 文件路径
# CUSTOM_JS=static/custom.js

# ================================
# 备份配置
# ================================

# 是否启用自动备份 (true/false)
ENABLE_AUTO_BACKUP=false

# 备份间隔 (小时)
BACKUP_INTERVAL=24

# 备份保留天数
BACKUP_RETENTION_DAYS=7

# 备份目录
BACKUP_DIR=backups